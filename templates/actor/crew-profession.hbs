<section class="tab crew-items crew-profession {{tab.cssClass}}" data-group="primary" data-tab="profession">
  {{#if profession}}
    <ol class="item-list">
      {{> "systems/scars/templates/actor/item-row.hbs" row=profession.row}}
    </ol>
    {{#if profession.domain}}
      <section class="crew-section">
        <h2>{{localize "SCARS.Item.domain"}}</h2>
        <p class="profession-domain">{{profession.domain}}</p>
      </section>
    {{/if}}
    {{#if profession.descriptionHTML}}
      <section class="crew-section">
        <h2>{{localize "SCARS.Sheet.description"}}</h2>
        <div class="profession-description">{{{profession.descriptionHTML}}}</div>
      </section>
    {{/if}}
  {{else}}
    <p class="empty-hint">{{localize "SCARS.Sheet.noProfession"}}</p>
  {{/if}}
</section>
