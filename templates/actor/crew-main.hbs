<section class="tab crew-main {{tab.cssClass}}" data-group="primary" data-tab="main">
  <section class="crew-section">
    <h2>{{localize "SCARS.Sheet.profile"}}</h2>
    <label class="field">
      <span>{{localize "SCARS.Sheet.player"}}</span>
      <input type="text" name="system.profile.player" value="{{system.profile.player}}">
    </label>
    <label class="field">
      <span>{{localize "SCARS.Sheet.origin"}}</span>
      <input type="text" name="system.profile.origin" value="{{system.profile.origin}}">
    </label>
    <label class="field">
      <span>{{localize "SCARS.Sheet.motivation"}}</span>
      <input type="text" name="system.profile.motivation" value="{{system.profile.motivation}}">
    </label>
  </section>

  <section class="crew-section">
    <h2>{{localize "SCARS.Sheet.attributes"}}</h2>
    <div class="attribute-grid">
      {{#each attributes}}
        <div class="attribute">
          <button type="button" class="attribute-roll" data-action="rollTest" data-attribute="{{key}}"
                  data-tooltip="{{localize "SCARS.Roll.rollAttribute" attribute=(localize label)}}">
            <i class="fa-solid fa-dice-d20" inert></i>
            <span class="attribute-label">{{localize label}}</span>
          </button>
          <input type="number" name="system.attributes.{{key}}" value="{{value}}" aria-label="{{localize label}}"
                 min="{{@root.attributeRange.min}}" max="{{@root.attributeRange.max}}" step="1">
        </div>
      {{/each}}
    </div>
    {{#unless system.attributeSpreadValid}}
      <p class="spread-warning">{{localize "SCARS.Sheet.invalidSpread"}}</p>
    {{/unless}}
  </section>

  <section class="crew-section resources">
    <div class="resource">
      <h2>{{localize "SCARS.Sheet.hitPoints"}}</h2>
      <div class="resource-values">
        <input type="number" name="system.hp.value" value="{{system.hp.value}}" min="0" max="{{system.hp.max}}" step="1">
        <span class="resource-separator">/</span>
        <span class="resource-max">{{system.hp.max}}</span>
      </div>
      <label class="field bonus">
        <span>{{localize "SCARS.Sheet.bonus"}}</span>
        <input type="number" name="system.hp.bonus" value="{{system.hp.bonus}}" min="0" step="1">
      </label>
    </div>
    <div class="resource">
      <h2>{{localize "SCARS.Sheet.sanity"}}</h2>
      <div class="resource-values">
        <input type="number" name="system.sanity.value" value="{{system.sanity.value}}" min="0" max="{{system.sanity.max}}" step="1">
        <span class="resource-separator">/</span>
        <span class="resource-max">{{system.sanity.max}}</span>
      </div>
      <label class="field bonus">
        <span>{{localize "SCARS.Sheet.bonus"}}</span>
        <input type="number" name="system.sanity.bonus" value="{{system.sanity.bonus}}" min="0" step="1">
      </label>
      <button type="button" class="horror-roll" data-action="rollHorror">
        <i class="fa-solid fa-ghost" inert></i>
        <span>{{localize "SCARS.Roll.horror"}}</span>
      </button>
    </div>
  </section>
</section>
