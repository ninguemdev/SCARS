<header class="crew-header">
  <img class="crew-portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}">
  <div class="crew-identity">
    <input class="crew-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize "SCARS.Sheet.name"}}">
    <div class="crew-status">
      {{#if system.status.shaken}}
        <span class="status-badge status-shaken">{{localize "SCARS.Status.shaken"}}</span>
      {{/if}}
      {{#if system.status.dying}}
        <span class="status-badge status-dying">{{localize "SCARS.Status.dying"}}</span>
      {{/if}}
    </div>
  </div>
</header>
