<div class="scars scars-card test-card outcome-{{outcome}}">
  <header class="card-title">{{title}}</header>
  <div class="card-readout">
    <div class="card-roll">
      <span class="card-formula">{{formula}}</span>
      <span class="card-dice">
        {{#each dice}}
          <span class="card-die{{#unless kept}} discarded{{/unless}}">{{value}}</span>
        {{/each}}
      </span>
    </div>
    <span class="card-total">{{total}}</span>
    <span class="card-target">
      <small>{{localize "SCARS.Roll.difficulty"}}</small>
      <span>{{difficulty}}</span>
    </span>
  </div>
  <p class="card-outcome">{{localize outcomeLabel}}</p>
  <dl class="card-details">
    <dt>{{localize "SCARS.Roll.natural"}}</dt>
    <dd>{{natural}}</dd>
    {{#if advantage}}
      <dt>{{localize "SCARS.Roll.advantage"}}</dt>
      <dd><i class="fa-solid fa-check" inert></i></dd>
    {{/if}}
  </dl>
  {{#if outcomeNote}}
    <p class="card-note">{{localize outcomeNote}}</p>
  {{/if}}
  {{#if rerollNote}}
    <p class="card-note card-reroll-note">
      <i class="fa-solid fa-shield-halved" inert></i>
      <span>{{rerollNote}}</span>
    </p>
  {{/if}}
  {{#if commanderReroll}}
    <button type="button" class="card-commander-reroll" data-scars-commander-reroll
            data-tooltip="{{localize "SCARS.Chat.commanderRerollHint"}}">
      <i class="fa-solid fa-shield-halved" inert></i>
      <span>{{localize "SCARS.Chat.commanderReroll"}}</span>
    </button>
  {{/if}}
  {{#if horror}}
    <dl class="card-details horror-details">
      {{#if horror.heavyScene}}
        <dt>{{localize "SCARS.Roll.heavyScene"}}</dt>
        <dd><i class="fa-solid fa-check" inert></i></dd>
      {{/if}}
      {{#if horror.loss}}
        <dt>{{localize "SCARS.Roll.sanityLoss"}}</dt>
        <dd>{{horror.loss.amount}} ({{horror.loss.formula}})</dd>
        <dt>{{localize "SCARS.Sheet.sanity"}}</dt>
        <dd>{{horror.loss.before}} → {{horror.loss.after}} / {{horror.loss.max}}</dd>
      {{/if}}
    </dl>
    {{#if horror.keptControl}}
      <p class="card-note">{{localize "SCARS.Roll.keptControl"}}</p>
    {{/if}}
  {{/if}}
</div>
