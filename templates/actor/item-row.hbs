<li class="item-card kind-{{row.kind}} draggable" data-item-id="{{row.id}}">
  <div class="item-card-icon">
    <img src="{{row.img}}" alt="">
  </div>
  <div class="item-card-body">
    <span class="item-card-name">{{row.name}}</span>
    {{#if row.detail}}
      <small class="item-card-detail">{{row.detail}}</small>
    {{/if}}
    {{#if row.uses}}
      <div class="uses-control">
        {{#if row.uses.label}}
          <span class="uses-label">{{row.uses.label}}</span>
        {{/if}}
        <button type="button" class="icon" data-action="changeUses" data-delta="-1"
                aria-label="{{localize "SCARS.Sheet.decreaseUses"}}" data-tooltip="{{localize "SCARS.Sheet.decreaseUses"}}"
                {{#unless row.uses.canDecrease}}disabled{{/unless}}>
          <i class="fa-solid fa-minus" inert></i>
        </button>
        {{#if row.uses.pips.length}}
          <span class="uses-pips" aria-hidden="true">
            {{#each row.uses.pips}}
              <span class="pip{{#if filled}} is-filled{{/if}}"></span>
            {{/each}}
          </span>
        {{/if}}
        <span class="uses-value">{{row.uses.value}}/{{row.uses.max}}</span>
        <button type="button" class="icon" data-action="changeUses" data-delta="1"
                aria-label="{{localize "SCARS.Sheet.increaseUses"}}" data-tooltip="{{localize "SCARS.Sheet.increaseUses"}}"
                {{#unless row.uses.canIncrease}}disabled{{/unless}}>
          <i class="fa-solid fa-plus" inert></i>
        </button>
      </div>
    {{else if row.oncePerTarget}}
      <span class="uses-chip"><i class="fa-solid fa-user-shield" inert></i>{{localize "SCARS.Item.oncePerTarget"}}</span>
    {{else if row.unlimited}}
      <span class="uses-chip"><i class="fa-solid fa-infinity" inert></i>{{localize "SCARS.Sheet.unlimited"}}</span>
    {{/if}}
  </div>
  <div class="item-card-actions">
    {{#if row.usable}}
      <button type="button" class="use-item" data-action="useItem"
              aria-label="{{localize "SCARS.Sheet.useItem"}}" data-tooltip="{{localize "SCARS.Sheet.useItem"}}"
              {{#unless row.canUse}}disabled{{/unless}}>
        <i class="fa-solid fa-power-off" inert></i>
        <span>{{localize "SCARS.Sheet.useItem"}}</span>
      </button>
    {{/if}}
    <button type="button" class="icon" data-action="editItem"
            aria-label="{{localize "SCARS.Sheet.editItem"}}" data-tooltip="{{localize "SCARS.Sheet.editItem"}}">
      <i class="fa-solid fa-pen-to-square" inert></i>
    </button>
    <button type="button" class="icon" data-action="deleteItem"
            aria-label="{{localize "SCARS.Sheet.deleteItem"}}" data-tooltip="{{localize "SCARS.Sheet.deleteItem"}}">
      <i class="fa-solid fa-trash" inert></i>
    </button>
  </div>
</li>
