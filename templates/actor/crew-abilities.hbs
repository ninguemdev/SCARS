<section class="tab crew-items crew-abilities {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  {{#if abilities.length}}
    <ol class="item-list">
      {{#each abilities as |row|}}
        {{> "systems/scars/templates/actor/item-row.hbs" row=row}}
      {{/each}}
    </ol>
  {{else}}
    <p class="empty-hint">{{localize "SCARS.Sheet.noAbilities"}}</p>
  {{/if}}
</section>
