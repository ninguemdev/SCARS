<header class="item-header">
  <div class="portrait-frame item-image-frame">
    <img class="item-image" src="{{item.img}}" data-edit="img" data-action="editImage" alt="{{item.name}}">
  </div>
  <div class="item-identity">
    <span class="item-type">{{localize typeLabel}}</span>
    <input class="item-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize "SCARS.Sheet.name"}}">
  </div>
</header>
